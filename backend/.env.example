# Copy to .env and fill in. Never commit .env.

# ── Runtime mode (CF-0023) ────────────────────────────────────────────────
# Only "development" or "local" enables dev behavior (/docs, /openapi.json,
# Expo localhost CORS origins). Anything else, or unset, is production.
# Production deploys MUST set APP_ENV=production explicitly.
APP_ENV=development

# ── Field encryption for TIN / RSBSA (CF-0007, CF-0021) ────────────────────
# base64 of 32 random bytes each; the two keys must differ. The app does not
# start if a key is missing, malformed, or cannot decrypt a stored TIN.
# Make a key:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
FIELD_HMAC_KEY=
# Only during key rotation: the old key, read-only.
FIELD_ENCRYPTION_KEY_PREVIOUS=

# ── Core ──────────────────────────────────────────────────────────────────
DATABASE_URL=
PGSSL_CA=
PGSSL_SERVERNAME=
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_TRUST_PROXY=

# ── Auth ──────────────────────────────────────────────────────────────────
BETTER_AUTH_URL=
AUTH_SYNC_SHARED_SECRET=
FASTAPI_JWT_SECRET=

# ── Payments (PayMongo) ───────────────────────────────────────────────────
PAYMONGO_USE_TEST=true
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_TEST_KEY=
PAYMONGO_SECRET_TEST_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Messaging ─────────────────────────────────────────────────────────────
RESEND_KEY=
RESEND_FROM=
SEMAPHORE_KEY=
SEMAPHORE_SENDER_NAME=
UNISMS_API_SECRET_KEY=

# ── Maps ──────────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=
