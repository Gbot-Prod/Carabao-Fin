# API (FastAPI). Copy to .env and fill in. PLACEHOLDERS ONLY in this file:
# never put a real key or password here.
# Every name is explained in documentation/manuals/SUBDOMAINS.md and
# documentation/manuals/SYSTEM_REFERENCE.md (section 4.1).

APP_ENV=development
DATABASE_URL=postgresql://user:change-me@localhost:5432/carabao
PGSSL_CA=
PGSSL_SERVERNAME=

# Make each with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# The two must differ. Never change FIELD_HMAC_KEY after data exists.
FIELD_ENCRYPTION_KEY=change-me
FIELD_HMAC_KEY=change-me
FIELD_ENCRYPTION_KEY_PREVIOUS=

# ── Web sites ───────────────────────────────────────────────────────────────
# Every site that calls the API from a browser. No wildcards.
# One-host mode (SUBDOMAINS.md 5.5): http://localhost:3000,http://admin.carabao.test:3001
ALLOWED_ORIGINS=http://carabao.test:3000,http://merchant.carabao.test:3000,http://admin.carabao.test:3001
# Buyer site: PayMongo return pages.
APP_URL=http://carabao.test:3000
# Admin site: two-step setup links.
ADMIN_URL=http://admin.carabao.test:3001

# ── Tokens from the web app ─────────────────────────────────────────────────
# Issuer of every token: the public web origin.
BETTER_AUTH_URL=http://carabao.test:3000
AUTH_JWT_ISSUER=
# Public keys of each web deploy. Empty PUBLIC_JWKS_URL = <issuer>/api/auth/jwks.
PUBLIC_JWKS_URL=
# Admin deploy keys. Production: the Railway private URL, not through Cloudflare Access.
ADMIN_JWKS_URL=http://localhost:3001/api/auth/jwks
# Admin keys the API trusts (RFC 7638 thumbprints, comma separated). Empty = no
# admin tokens. After the first admin sign-in: uv run python scripts/admin_jwk_thumbprints.py
ADMIN_JWKS_THUMBPRINTS=
# Same value as the web app's AUTH_SYNC_SHARED_SECRET.
AUTH_SYNC_SHARED_SECRET=change-me
RATE_LIMIT_TRUST_PROXY=

# ── PayMongo ────────────────────────────────────────────────────────────────
PAYMONGO_USE_TEST=true
PAYMONGO_SECRET_TEST_KEY=change-me
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=change-me

# ── Cloudflare R2 ───────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=change-me
CLOUDFLARE_R2_BUCKET_NAME=change-me
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=change-me
CLOUDFLARE_R2_PUBLIC_URL=https://change-me.example
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me

# ── Email, SMS, maps ────────────────────────────────────────────────────────
RESEND_KEY=change-me
RESEND_FROM=Carabao <onboarding@resend.dev>
SEMAPHORE_KEY=change-me
SEMAPHORE_SENDER_NAME=change-me
MAPBOX_ACCESS_TOKEN=change-me
# Map pin road check (optional). Use osrm on a network that blocks Mapbox.
# ROAD_SNAP_PROVIDER=mapbox
# ROAD_SNAP_MAX_METERS=150
# OSRM_URL=https://router.project-osrm.org

# Reference prices (guardrails Phase 4): DA Price Index API, NCR only. The API
# process syncs it with app/data/inhouse_reference_prices.csv every
# DA_PRICE_SYNC_HOURS (default 6; 0 = off). Defaults are in
# app/services/da_price_sync.py.
# DA_PRICE_API_URL=https://dapricescraper-production.up.railway.app
# DA_PRICE_SYNC_HOURS=6
