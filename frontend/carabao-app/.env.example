# Web app (Next.js). Copy to .env.local and fill in. PLACEHOLDERS ONLY in this
# file: never put a real key or password here.
# Every name is explained in documentation/manuals/SUBDOMAINS.md.
# NEXT_PUBLIC_*, ROOT_DOMAIN and APP_SURFACE are fixed at build: rebuild after a change.

# ── Database (the same Postgres as the API) ─────────────────────────────────
DATABASE_URL=postgresql://user:change-me@localhost:5432/carabao
PGSSL_CA=
PGSSL_SERVERNAME=

# ── Surfaces and hosts ──────────────────────────────────────────────────────
# Local subdomains need hosts-file entries (SUBDOMAINS.md, "Local setup").
# With NEXT_PUBLIC_APP_URL=http://localhost:3000 the site runs on one host
# (no subdomains, /merchant/... and /help/... paths).
ROOT_DOMAIN=carabao.test
APP_SURFACE=public
NEXT_PUBLIC_APP_URL=http://carabao.test:3000
# Optional: derived from NEXT_PUBLIC_APP_URL (merchant.<root>, help.<root>).
NEXT_PUBLIC_MERCHANT_URL=
NEXT_PUBLIC_HELP_URL=
# The admin site runs on its own port locally, so set it.
NEXT_PUBLIC_ADMIN_URL=http://admin.carabao.test:3001

# ── Better Auth ─────────────────────────────────────────────────────────────
# Make with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://carabao.test:3000
# Issuer of every API token. Empty on the public site (= BETTER_AUTH_URL).
AUTH_JWT_ISSUER=
# Extra trusted origins, comma list (optional).
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_RATE_LIMIT=
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
FACEBOOK_CLIENT_ID=change-me
FACEBOOK_CLIENT_SECRET=change-me

# ── API ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Same value as the API's AUTH_SYNC_SHARED_SECRET.
AUTH_SYNC_SHARED_SECRET=change-me

# ── Other ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_API_KEY=change-me
CSP_ENFORCE=
MOCK_AUTH_SESSION=false
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=
NEXT_PUBLIC_FEATURE_LANGUAGE_TOGGLE=

# ════════════════════════════════════════════════════════════════════════════
# Admin site (npm run dev:admin). Put these lines in .env.admin.local; they
# replace the values above for the admin dev server only.
# BETTER_AUTH_SECRET MUST differ from the public one (SUBDOMAINS.md).
# ════════════════════════════════════════════════════════════════════════════
# BETTER_AUTH_SECRET=change-me-admin
# BETTER_AUTH_URL=http://admin.carabao.test:3001
# AUTH_JWT_ISSUER=http://carabao.test:3000
# NEXT_PUBLIC_ADMIN_URL=http://admin.carabao.test:3001
